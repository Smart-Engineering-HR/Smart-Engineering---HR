datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. إدارة المستخدمين والتحكم بالوصول (مدمج ومنظم)
// ==========================================

model User {
  id               String    @id @default(uuid())
  name             String    @default("غير محدد")
  email            String    @unique
  password         String
  role             String    @default("admin") // "job-seeker", "supplier", "admin"
  phone            String    @default("")
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ==========================================
// 2. التوظيف والمناقصات التفصيلية
// ==========================================

model Posting {
  id             String   @id @default(uuid())
  itemType       String   // "job" أو "tender"
  title          String
  company        String
  category       String?
  type           String?
  location       String?
  publishDate    String?
  endDate        String?
  duties         String?
  qualifications String?
  tenderNumber   String?
  projectName    String?
  applyMethod    String?
  applyEmail     String?
  applyUrl       String?
  documentsLink  String?
  notes          String?
  createdAt      DateTime @default(now())
}

// ==========================================
// 3. طلبات ومساحات الإعلانات التجارية للشركات
// ==========================================

model Advertisement {
  id            String   @id @default(uuid())
  companyName   String
  contactPerson String
  phone         String
  email         String
  address       String?
  website       String?
  type          String?  // 👈 إرجاع العمود
  is_published  Boolean? @default(false) // 👈 إرجاع العمود
  advertiseType String
  moreInfo      String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
}

// ==========================================
// 4. قسم الأكاديمية والتدريب
// ==========================================
model AcademyItem {
  id          String   @id @default(uuid())
  category    String
  title       String
  subCategory String?
  description String?  // 👈 إرجاع العمود لتجنب حذفه
  details     String   @db.Text
  status      String   @default("APPROVED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}



model TrainingItem {
  id            String                 @id @default(uuid())
  title         String
  type          String
  category      String
  price         String
  requirements  String
  fileUrl       String?
  createdAt     DateTime               @default(now())
  registrations TrainingRegistration[]
}

model TrainingRegistration {
  id             String       @id @default(uuid())
  trainingItemId String
  trainingItem   TrainingItem @relation(fields: [trainingItemId], references: [id], onDelete: Cascade)
  fullName       String
  email          String
  phone          String
  paymentStatus  String       @default("PENDING")
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
}

// ==========================================
// 5. قسم المنح الدراسية
// ==========================================

model Scholarship {
  id           String                   @id @default(uuid())
  title        String
  country      String
  level        String
  funding      String
  publishDate  DateTime                 @default(now())
  deadline     DateTime
  details      String
  createdAt    DateTime                 @default(now())
  applications ScholarshipApplication[]
}

model ScholarshipApplication {
  id            String      @id @default(uuid())
  scholarshipId String
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  fullName      String
  email         String
  phone         String
  cvUrl         String
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now())
}

// 👈 أضف هذا الموديل الجديد هنا بنفس الحقول التي يطلبها الـ API
model AcademyApplication {
  id              String   @id @default(uuid())
  fullName        String
  email           String
  phone           String
  scholarshipName String?
  degree          String?
  gpa             String?
  university      String?
  major           String?
  languageLevel   String?
  status          String   @default("PENDING")
  details         String?  @db.Text
  createdAt       DateTime @default(now())
}

// ==========================================
// 6. المكتبة والبرمجيات (محدثة لدعم قاعدة البيانات الدائمة)
// ==========================================

model StructuralCode {
  id        String   @id @default(uuid())
  title     String
  category  String
  fileUrl   String
  createdAt DateTime @default(now())
}

model SoftwareTool {
  id           String   @id @default(uuid())
  title        String
  category     String
  stage        String   @default("design") // design, execution, technical-office
  badge        String   @default("مجانية") // مجانية, تجريبية, Pro
  aiPlatform   String   @default("محرك المنصة")
  description  String   @db.Text
  secretPrompt String?  @db.Text
  placeholders String[] @default([])
  logic        String?  @db.Text
  variables    Json?
  videoUrl     String?
  pdfPath      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SoftwareToolRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  details   String   @db.Text
  createdAt DateTime @default(now())
}

// ==========================================
// 7. الخدمات الهندسية والمحتوى العلمي
// ==========================================

model Service {
  id        String   @id @default(cuid())
  category  String   // structural, architecture, smartTech, academy
  title     String
  desc      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceRequest {
  id              String   @id @default(cuid())
  type            String
  serviceCategory String
  serviceName     String
  fullName        String
  email           String
  phone           String
  subject         String
  customSubject   String?
  message         String
  dateTime        String?
  createdAt       DateTime @default(now())
}
// ==========================================
// 8. التواصل، الدعم الفني وتجربة المستخدم
// ==========================================

model UserFeedback {
  id          String   @id @default(uuid())
  name        String?
  specialty   String
  type        String
  serviceName String?
  quality     Int?
  commitment  Int?
  response    Int?
  improvement String?
  scriptIdea  String?
  uxRating    String?
  screenshot  String?
  message     String
  sharePublic Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id          String   @id @default(uuid())
  fullName    String
  email       String
  subject     String
  message     String
  filePath    String?
  bookingDate String?
  createdAt   DateTime @default(now())
}

model ContactRequest {
  id        String   @id @default(uuid())
  type      String   // "AD", "JOB_SEEKER", "SUPPLIER", "LOGIN"
  data      String   // تخزين البيانات بصيغة JSON
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}